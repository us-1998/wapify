NODE_ENV=production
PORT=3000
APP_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com

DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
REDIS_URL=redis://default:PASSWORD@host.upstash.io:6379

JWT_SECRET=change-this-to-64-random-chars
JWT_REFRESH_SECRET=change-this-to-different-64-random-chars
JWT_EXPIRES_IN=15m

ADMIN_JWT_SECRET=change-this-to-another-64-random-chars
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=AdminWapify@2026

META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=any_random_string_you_choose
META_SYSTEM_USER_TOKEN=EAAxxxxxxxxxxxxxxxxxx

STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PRICE_GROWTH_MONTHLY=price_xxxx
STRIPE_PRICE_GROWTH_ANNUAL=price_xxxx
STRIPE_PRICE_SCALE_MONTHLY=price_xxxx
STRIPE_PRICE_SCALE_ANNUAL=price_xxxx
STRIPE_PRICE_AGENCY_MONTHLY=price_xxxx
STRIPE_PRICE_AGENCY_ANNUAL=price_xxxx

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Wapify

SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_orders,read_products,read_customers,write_orders

RATE_LIMIT_MAX=200
