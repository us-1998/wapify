# ═══════════════════════════════════════════════════════
#  WAPIFY — Environment Variables
#  Copy this to .env and fill in your values
#  NEVER commit .env to git
# ═══════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_URL=https://yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
API_URL=https://api.yourdomain.com

# ── Database (PostgreSQL) ─────────────────────────────────
DATABASE_URL=postgresql://wapify_user:STRONG_PASSWORD@localhost:5432/wapify
# OR use Supabase free tier: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres

# ── Redis (message queue + cache) ────────────────────────
REDIS_URL=redis://localhost:6379
# OR use Upstash free tier: redis://default:[password]@[host]:6379

# ── JWT ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_64_CHAR_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Admin ─────────────────────────────────────────────────
ADMIN_JWT_SECRET=DIFFERENT_64_CHAR_SECRET_FOR_ADMIN
ADMIN_EMAIL=admin@wapify.com
ADMIN_INITIAL_PASSWORD=ChangeThis@FirstLogin

# ── Meta WhatsApp Business API ───────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_custom_webhook_verify_token
# Permanent system user token (from Meta Business Manager)
META_SYSTEM_USER_TOKEN=EAAxxxxxxxxxxxxxxxxxx

# ── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_GROWTH_MONTHLY=price_xxxx
STRIPE_PRICE_GROWTH_ANNUAL=price_xxxx
STRIPE_PRICE_SCALE_MONTHLY=price_xxxx
STRIPE_PRICE_SCALE_ANNUAL=price_xxxx
STRIPE_PRICE_AGENCY_MONTHLY=price_xxxx
STRIPE_PRICE_AGENCY_ANNUAL=price_xxxx

# ── Email (Brevo / SendGrid / SMTP) ──────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_email@domain.com
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Wapify

# ── Shopify ───────────────────────────────────────────────
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_SCOPES=read_orders,read_products,read_customers,write_orders

# ── Twilio (SMS fallback) ─────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ── File Storage (Cloudflare R2 / AWS S3) ────────────────
S3_ENDPOINT=https://[account-id].r2.cloudflarestorage.com
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET=wapify-media
S3_PUBLIC_URL=https://media.yourdomain.com

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
